<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:win="using:AvaWin"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="300">
      <StackPanel Spacing="12">
        <ListBox>
          <ListBoxItem Content="Item" />
          <ListBoxItem Content="Selected" IsSelected="True" />
          <ListBoxItem Content="Disabled" IsEnabled="False" />
        </ListBox>
        <ListBox win:ListStyle.SelectionStyle="Bordered">
          <ListBoxItem Content="Bordered item" />
          <ListBoxItem Content="Bordered selected" IsSelected="True" />
        </ListBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource ListBoxItemBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForeground}" />
    <Setter Property="Padding" Value="{DynamicResource ListBoxItemPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ListBoxItemMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource WinFontSizeBody}" />
    <Setter Property="FontWeight" Value="{DynamicResource WinFontWeightBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Container">
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <Border Name="PART_SelectionBorder"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  BorderBrush="{DynamicResource ListBoxItemSelectionBorderBrush}"
                  BorderThickness="{DynamicResource ListBoxItemSelectionBorderThickness}" />
          <Panel Name="PART_SelectionCheckmark"
                 IsVisible="False"
                 IsHitTestVisible="False"
                 Width="{DynamicResource WinListViewCheckmarkSize}" Height="{DynamicResource WinListViewCheckmarkSize}"
                 HorizontalAlignment="Right" VerticalAlignment="Top">
            <Polygon Points="0,0 40,0 40,40" Stretch="Fill" Fill="{DynamicResource ListBoxItemSelectionCheckmarkBackgroundBrush}" />
            <TextBlock Text="&#xE081;"
                       FontFamily="{DynamicResource WinSymbolFontFamily}"
                       FontSize="{DynamicResource WinListViewCheckmarkFontSize}"
                       Foreground="{DynamicResource ListBoxItemSelectionCheckmarkBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="{DynamicResource WinListViewCheckmarkPadding}" />
          </Panel>
          <Border Name="PART_HoverOutline"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Margin="-3"
                  BorderBrush="{DynamicResource ListBoxItemHoverOutlineBrush}"
                  BorderThickness="{DynamicResource ListBoxItemHoverOutlineThickness}" />
          <Border Name="PART_FocusOutline"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Margin="-2"
                  BorderBrush="{DynamicResource ListBoxItemFocusOutlineBrush}"
                  BorderThickness="{DynamicResource ListBoxItemFocusOutlineThickness}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundDisabled}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundPointerOver}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_HoverOutline">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundPressed}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusOutline">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:selected">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundSelected}" />
      </Style>
      <Style Selector="^:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundSelected}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelectedPointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundSelectedPointerOver}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelectedPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundSelectedPressed}" />
      </Style>
    </Style>

    <Style Selector="^[(win|ListStyle.SelectionStyle)=Bordered]:selected">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForeground}" />
      </Style>
      <Style Selector="^:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForeground}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundPointerOver}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundPressed}" />
      </Style>
      <Style Selector="^ /template/ Border#PART_SelectionBorder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Panel#PART_SelectionCheckmark">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#PART_SelectionBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ListBoxItemSelectionBorderBrushPointerOver}" />
      </Style>
      <Style Selector="^:pointerover /template/ Panel#PART_SelectionCheckmark Polygon">
        <Setter Property="Fill" Value="{DynamicResource ListBoxItemSelectionCheckmarkBackgroundBrushPointerOver}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
