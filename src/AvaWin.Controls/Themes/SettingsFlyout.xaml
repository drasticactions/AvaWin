<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:win="using:AvaWin.Controls"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="400" Height="300">
      <win:SettingsFlyoutPresenter Header="Options">
        <StackPanel Classes="win-settings-section">
          <TextBlock Text="A setting" />
          <ToggleSwitch />
        </StackPanel>
      </win:SettingsFlyoutPresenter>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type win:SettingsFlyoutPresenter}" TargetType="win:SettingsFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SettingsFlyoutBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsFlyoutBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsFlyoutForeground}" />
    <Setter Property="FontFamily" Value="{DynamicResource WinFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource WinFontSizeBody}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding SafeAreaPadding}">
          <Border Name="PART_Body"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Width="{DynamicResource WinSettingsFlyoutNarrowWidth}">
          <DockPanel>
            <Grid Name="PART_Header"
                  DockPanel.Dock="Top"
                  Background="{DynamicResource SettingsFlyoutHeaderBackground}"
                  ColumnDefinitions="Auto,*"
                  Height="{DynamicResource WinSettingsFlyoutHeaderHeight}"
                  Margin="{DynamicResource WinSettingsFlyoutHeaderPadding}">
              <win:BackButton Name="PART_BackButton"
                              Classes="small"
                              Grid.Column="0"
                              Margin="0,3,0,0"
                              VerticalAlignment="Top" />
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Padding="{DynamicResource WinSettingsFlyoutTitlePadding}"
                                VerticalAlignment="Top"
                                TextElement.FontSize="{DynamicResource WinFontSizeXLarge}"
                                TextElement.FontWeight="{DynamicResource WinFontWeightXLarge}" />
            </Grid>
            <ScrollViewer Name="PART_Content"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{DynamicResource WinSettingsFlyoutContentPadding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ScrollViewer>
          </DockPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:wide /template/ Border#PART_Body">
      <Setter Property="Width" Value="{DynamicResource WinSettingsFlyoutWideWidth}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
