<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:win="using:AvaWin.Controls"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="12">
        <win:Rating UserRating="3" />
        <win:Rating AverageRating="3.5" />
        <win:Rating UserRating="4" Classes="small" />
        <win:Rating UserRating="2" IsEnabled="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type win:RatingStar}" TargetType="win:RatingStar">
    <Setter Property="Width" Value="{DynamicResource WinRatingStarWidth}" />
    <Setter Property="Padding" Value="{DynamicResource WinRatingStarPadding}" />
    <Setter Property="FontSize" Value="{DynamicResource WinRatingStarSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource WinSymbolFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource RatingStarForegroundEmpty}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" Margin="{TemplateBinding Padding}">
          <TextBlock Name="PART_Empty"
                     Text="&#xE082;"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}"
                     Foreground="{DynamicResource RatingStarForegroundEmpty}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center" />
          <Border Name="PART_Clip" HorizontalAlignment="Left" ClipToBounds="True">
            <TextBlock Name="PART_Full"
                       Text="&#xE082;"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:user-full">
      <Setter Property="Foreground" Value="{DynamicResource RatingStarForegroundUser}" />
    </Style>
    <Style Selector="^:tentative-full">
      <Setter Property="Foreground" Value="{DynamicResource RatingStarForegroundTentative}" />
    </Style>
    <Style Selector="^:average-full, ^:average-fractional">
      <Setter Property="Foreground" Value="{DynamicResource RatingStarForegroundAverage}" />
    </Style>
    <Style Selector="^:user-empty /template/ Border#PART_Clip, ^:tentative-empty /template/ Border#PART_Clip, ^:average-empty /template/ Border#PART_Clip">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type win:Rating}" TargetType="win:Rating">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
          <StackPanel Name="PART_Stars" Orientation="Horizontal" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource WinFocusOutlineBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
