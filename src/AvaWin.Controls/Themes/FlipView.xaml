<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:win="using:AvaWin.Controls"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="500" Height="300">
      <win:FlipView>
        <TextBlock Text="Page 1" />
        <TextBlock Text="Page 2" />
      </win:FlipView>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="WinFlipViewNavButton" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource WinFlipViewNavButtonWidth}" />
    <Setter Property="Height" Value="{DynamicResource WinFlipViewNavButtonHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource FlipViewNavButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FlipViewNavButtonForeground}" />
    <Setter Property="FontFamily" Value="{DynamicResource WinSymbolFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource WinFlipViewNavButtonFontSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FlipViewNavButtonBackgroundPointerOver}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FlipViewNavButtonForegroundPointerOver}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FlipViewNavButtonBackgroundPressed}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FlipViewNavButtonForegroundPressed}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type win:FlipView}" TargetType="win:FlipView">
    <Setter Property="MinHeight" Value="{DynamicResource WinFlipViewDefaultHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" Background="{TemplateBinding Background}">
          <Panel Name="PART_Viewport" ClipToBounds="True">
            <ContentPresenter Name="PART_PageA" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <ContentPresenter Name="PART_PageB" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Panel>
          <Button Name="PART_PreviousButton"
                  Theme="{StaticResource WinFlipViewNavButton}"
                  Content="&#xE0E2;"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center" />
          <Button Name="PART_NextButton"
                  Theme="{StaticResource WinFlipViewNavButton}"
                  Content="&#xE0E3;"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover:canprevious /template/ Button#PART_PreviousButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover:cannext /template/ Button#PART_NextButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:vertical /template/ Button#PART_PreviousButton">
      <Setter Property="Content" Value="&#xE0E4;" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="^:vertical /template/ Button#PART_NextButton">
      <Setter Property="Content" Value="&#xE0E5;" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
