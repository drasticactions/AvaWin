<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:win="https://github.com/avawin"
             x:Class="AvaWin.Gallery.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <win:AvaWinTheme Platform="Auto" />
    <win:AvaWinControlsTheme />
    <StyleInclude Source="avares://AvaWin.Gallery/Framework/GalleryStyles.axaml" />
  </Application.Styles>
</Application>
